# SQL Server
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=your_password
DB_NAME=TEKNIKDB

# Sunucu
PORT=5000
NODE_ENV=development

# Güvenlik (production'da mutlaka güçlü bir değer kullanın)
JWT_SECRET=degistirin-guclu-rastgele-bir-anahtar

# Frontend adresi (WhatsApp takip linkleri için)
PUBLIC_FRONTEND_URL=http://localhost:3000

# CORS (virgülle ayırın)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Hatırlatmalar (gün)
REMINDER_PICKUP_DAYS=7

# Sunucu/istemci modu: uzak SQL'e bağlanan istemci için 'client', ana makine için 'server'
# APP_ROLE=server
